{
  "compilerOptions": {
    "target": "ES2020",
    "module": "NodeNext",
    "lib": ["ES2020"],
    "rootDir": "./electron",
    "outDir": "./dist-electron",
    "skipLibCheck": true,
    "esModuleInterop": true,
    "strict": true,
    "resolveJsonModule": true,
    "moduleResolution": "NodeNext"
  },
  "include": ["electron/**/*.ts"],
  "exclude": ["electron/preload.ts", "node_modules", "dist", "dist-electron"]
}
